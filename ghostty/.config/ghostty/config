# Gets fish without chsh'ing the login shell, so scripts and anything reading
# /etc/passwd keep getting zsh
command = /opt/homebrew/bin/fish

theme = TokyoNight Night

font-family = JetBrainsMono Nerd Font
font-size = 14

background-opacity = 0.85
background-blur-radius = 20

# ssh-terminfo installs xterm-ghostty on the remote host, so TERM does not have
# to be downgraded to xterm-256color to keep ssh usable
shell-integration-features = ssh-env,ssh-terminfo

# Sends tmux prefix (C-a) + f to open the fzf window switcher
keybind = cmd+p=text:\x01f

# Sends tmux prefix (C-a) + C to open a new window running claude
keybind = cmd+shift+n=text:\x01C

# Sends tmux prefix (C-a) + e to open the review popup
keybind = cmd+r=text:\x01e

# Sends tmux prefix (C-a) + g to open lazygit in a popup. Replaces Ghostty's
# own cmd+g (next search match), which tmux's scrollback makes little use of
keybind = cmd+g=text:\x01g

# Sends tmux prefix (C-a) + a to jump to the next Claude window waiting for you
keybind = cmd+i=text:\x01a
