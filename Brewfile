# Everything the stow packages in this repo assume is on PATH.
# Install with: brew bundle

brew "git"
brew "gh"
brew "stow"

# Shells
brew "fish"

# Terminal multiplexer (plugins are managed by TPM, see install.sh)
brew "tmux"

# Editor and the tools its pickers shell out to
brew "neovim"
brew "fzf"
brew "ripgrep"
brew "fd"
brew "lazygit"
# img-clip.nvim's only clipboard source on macOS
brew "pngpaste"

# Node toolchain
brew "nvm"
brew "pnpm"

cask "ghostty"
cask "font-jetbrains-mono-nerd-font"
